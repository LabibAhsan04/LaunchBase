# copy to .env. do not commit .env

APP_ENV=development
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://launchbase:launchbase@localhost:5433/launchbase?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# local only. generate a real one before anything leaves your machine.
SESSION_SECRET=dev-only-change-me

# worker deploy limits. export them if you want something other than the default.
CLONE_TIMEOUT=60s
BUILD_TIMEOUT=10m
START_TIMEOUT=60s
DEPLOYMENT_MEMORY_LIMIT=512m
DEPLOYMENT_CPU_LIMIT=1.0
DEPLOYMENT_PIDS_LIMIT=128
