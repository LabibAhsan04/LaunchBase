# copy to .env. do not commit .env

APP_ENV=development
API_ADDR=:8080
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://launchbase:launchbase@localhost:5433/launchbase?sslmode=disable
REDIS_URL=redis://localhost:6379/0
WORKER_ADDR=:8081

# local only. generate a real one before anything leaves your machine.
SESSION_SECRET=dev-only-change-me
# optional; defaults to SESSION_SECRET. rotate carefully — existing ciphertext becomes unreadable.
# ENV_ENCRYPTION_KEY=

# auth: dev uses the seeded local user when no session cookie is present.
# github requires a signed-in session for project and deployment APIs.
AUTH_MODE=dev
# comma-separated GitHub logins allowed to OAuth (empty = unrestricted). required for public demos.
AUTH_ALLOWLIST=
# bearer token for GET /api/v1/ops/status (empty hides the endpoint as 404)
OPS_TOKEN=
API_PUBLIC_URL=http://localhost:8080

# GitHub App (phase 7). leave blank for AUTH_MODE=dev without sign-in.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
# or inline PEM with \n for newlines:
# GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# extra env keys whose values are scrubbed from build logs
LOG_REDACT_ENV=

# worker deploy limits. export them if you want something other than the default.
CLONE_TIMEOUT=60s
BUILD_TIMEOUT=10m
START_TIMEOUT=60s
DEPLOYMENT_MEMORY_LIMIT=512m
DEPLOYMENT_CPU_LIMIT=1.0
DEPLOYMENT_PIDS_LIMIT=128

# routing (phase 8). Traefik serves *.launchbase.localhost on :80
BASE_DOMAIN=launchbase.localhost
RUNTIME_NETWORK=launchbase-runtime

# security limits (phase 9)
MAX_BUILDS_PER_USER=2
MAX_BUILDS_GLOBAL=10
MAX_READY_PER_USER=5
MAX_READY_GLOBAL=8
API_RATE_PER_MIN=120
AUTH_RATE_PER_MIN=20
# optional; often ignored by Docker Desktop overlay2 — see docs/security.md
# DEPLOYMENT_STORAGE_LIMIT=


