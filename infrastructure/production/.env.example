# Copy to infrastructure/production/.env and fill in. Never commit .env.

# Public hostname for the dashboard/API (A/AAAA record must point at this VM).
CONTROL_HOST=launchbase.example.com
BASE_DOMAIN=apps.example.com
ACME_EMAIL=you@example.com

# Browser-facing API origin (usually https://CONTROL_HOST).
NEXT_PUBLIC_API_URL=https://launchbase.example.com
WEB_ORIGIN=https://launchbase.example.com
API_PUBLIC_URL=https://launchbase.example.com

# Postgres (compose injects DATABASE_URL for api/worker).
POSTGRES_USER=launchbase
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=launchbase

# Auth — production must use github + allowlist.
AUTH_MODE=github
AUTH_ALLOWLIST=your-github-login
SESSION_SECRET=replace-with-openssl-rand-hex-32
# Prefer a dedicated key for project env ciphertext (falls back to SESSION_SECRET).
ENV_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
OPS_TOKEN=replace-with-ops-token

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Absolute path on the VM to the GitHub App PEM (mounted read-only).
GITHUB_APP_PRIVATE_KEY_HOST_PATH=/etc/launchbase/github-app.pem
GITHUB_WEBHOOK_SECRET=

# Cost controls
MAX_BUILDS_PER_USER=1
MAX_BUILDS_GLOBAL=3
MAX_READY_PER_USER=2
MAX_READY_GLOBAL=4
API_RATE_PER_MIN=60
AUTH_RATE_PER_MIN=10

CLONE_TIMEOUT=60s
BUILD_TIMEOUT=10m
START_TIMEOUT=60s
DEPLOYMENT_MEMORY_LIMIT=512m
DEPLOYMENT_CPU_LIMIT=1.0
DEPLOYMENT_PIDS_LIMIT=128
RUNTIME_NETWORK=launchbase-runtime
